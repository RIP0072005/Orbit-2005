@using Orbit_2005.Models
@model Order

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Manage Order #{Model.Id}";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-light fw-bold m-0">
            <i class="bi bi-receipt text-info me-2"></i>Order <span class="text-info">#@Model.Id</span>
        </h2>
        <div>
            <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning fw-bold px-4">
                <i class="bi bi-pencil-square"></i> Edit Order
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary px-4 ms-2">
                Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <!-- عمود البيانات الأساسية (يمين الشاشة) -->
        <div class="col-lg-4 mb-4">
            <div class="card bg-dark border-secondary shadow-sm mb-4">
                <div class="card-header border-secondary bg-transparent py-3">
                    <h5 class="card-title text-info m-0 text-uppercase">Summary & Status</h5>
                </div>
                <div class="card-body text-light">
                    <div class="mb-3">
                        <strong class="d-block text-white-50">Current Status:</strong>
                        @switch (Model.Status)
                        {
                            case OrderStatus.pending:
                                <span class="badge bg-warning text-dark fs-6 mt-1">Pending</span>
                                break;
                            case OrderStatus.shiped:
                                <span class="badge bg-info text-dark fs-6 mt-1">Shipped</span>
                                break;
                            case OrderStatus.delivered:
                                <span class="badge bg-success fs-6 mt-1">Delivered</span>
                                break;
                            case OrderStatus.canceled:
                                <span class="badge bg-danger fs-6 mt-1">Canceled</span>
                                break;
                        }
                    </div>
                    <div class="mb-3">
                        <strong class="d-block text-white-50">Order Date:</strong>
                        <span>@Model.OrderDate.ToString("dd MMM yyyy, HH:mm")</span>
                    </div>
                    <div class="mb-3">
                        <strong class="d-block text-white-50">Total Value:</strong>
                        <span class="text-success fs-4 fw-bold">$@Model.TotalPrice</span>
                    </div>
                </div>
            </div>

            <div class="card bg-dark border-secondary shadow-sm">
                <div class="card-header border-secondary bg-transparent py-3">
                    <h5 class="card-title text-info m-0 text-uppercase">Shipping Info</h5>
                </div>
                <div class="card-body text-light">
                    <div class="mb-3">
                        <strong class="d-block text-white-50">Address:</strong>
                        <span>@Model.Address</span>
                    </div>
                    <div class="mb-3">
                        <strong class="d-block text-white-50">Phone Number:</strong>
                        <span>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)</span>
                    </div>
                    <div class="mb-3">
                        <strong class="d-block text-white-50">Customer Notes:</strong>
                        <span class="text-warning">@(string.IsNullOrEmpty(Model.Description) ? "No notes provided." : Model.Description)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- عمود المنتجات (شمال الشاشة) -->
        <div class="col-lg-8">
            <div class="card bg-dark border-secondary shadow-sm">
                <div class="card-header border-secondary bg-transparent py-3">
                    <h5 class="card-title text-info m-0 text-uppercase">Purchased Items</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover table-borderless m-0">
                            <thead class="border-bottom border-secondary text-white-50">
                                <tr>
                                    <th class="ps-4 py-3">Product Name</th>
                                    <th class="py-3 text-center">Unit Price</th>
                                    <th class="py-3 text-center">Qty</th>
                                    <th class="pe-4 py-3 text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderItems != null)
                                {
                                    foreach (var item in Model.OrderItems)
                                    {
                                        <tr class="align-middle border-bottom border-secondary" style="border-bottom-color: rgba(255,255,255,0.05) !important;">
                                            <td class="ps-4 py-3 text-light fw-bold">@(item.Product?.Name ?? "Product Deleted")</td>
                                            <td class="py-3 text-center text-white-50">$@item.Price</td>
                                            <td class="py-3 text-center">
                                                <span class="badge bg-secondary text-light px-2 py-1">@item.Quantity</span>
                                            </td>
                                            <td class="pe-4 py-3 text-end text-success fw-bold">$@(item.Price* item.Quantity)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>