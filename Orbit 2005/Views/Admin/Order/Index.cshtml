@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@model List<Order>
@section Styles {
    <link href="~/css/admin-products.css" rel="stylesheet" />
}

@section Breadcrumb {
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0 border-bottom border-secondary pb-2">
            <li class="breadcrumb-item">
                <a asp-controller="Admin" asp-action="Index" class="text-decoration-none" style="color: var(--cosmic-accent);">Orbit 2005</a>
            </li>
            <li class="breadcrumb-item active text-light" aria-current="page">Current Page Name</li>
        </ol>
    </nav>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="cosmic-page-title">Products Inventory</h2>
    <a asp-controller="Product" asp-action="Create" class="btn btn-cosmic">+ Add New Product</a>
</div>

<div class="table-responsive">
    <table class="table cosmic-table align-middle text-center">
        <thead>
            <tr>
                <th style="width: 10%;">Product ID</th>
                <th style="width: 15%;">Date</th>
                <th style="width: 15%;">Total Price</th>
                <th style="width: 15%;">Status</th>
                <th style="width: 45%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string bg_color = item.Status switch
                {
                    OrderStatus.pending => "bg-warning",
                    OrderStatus.shiped => "bg-info",
                    OrderStatus.delivered => "bg-success",
                    OrderStatus.canceled => "bg-danger"
                };
                <tr>
                    <td class="text-black-50 fw-bold">@item.Id</td>
                    <td class="text-black-50 fw-bold">@item.OrderDate.ToShortDateString()</td>
                    <td class="text-black-50 fw-bold">@item.TotalPrice</td>
                    <td><span class="badge @bg_color text-dark fw-bold">@item.Status</span></td>
                    <td>
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info px-3">Details</a>
                            <a asp-controller="Order" asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning px-3">Edit</a>
                            <!--Version 1 of deleting-->
                            @* <a asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to delete this product?');" class="btn btn-sm btn-outline-danger px-3">Delete</a> *@

                            <!--Version 2 of deleting-->
                            @* <form asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are You Sure You Want To delete this product?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger px-3">Delete</button>
                            </form> *@

                            <a asp-controller="Order" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-3">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<div class="card-body p-0">
    <div class="table-responsive">
        <table class="table table-dark table-hover mb-0 text-center cosmic-table">
            <thead class="table-active">
                <tr>
                    <th>Order ID</th>
                    <th>Destination Sector</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    string bg_color = order.Status switch
                    {
                        OrderStatus.pending => "bg-warning",
                        OrderStatus.shiped => "bg-info",
                        OrderStatus.delivered => "bg-success",
                        OrderStatus.canceled => "bg-danger"
                    };
                    <tr>
                        <td>#ORD-@order.Id</td>
                        <td>@order.PhoneNumber</td>
                        <td>@order.Address</td>
                        <td class="text-success fw-bold">$@order.TotalPrice</td>
                        <td><span class="badge @bg_color text-dark">@order.Status</span></td>
                        <td>$@order.OrderDate</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="mt-4 p-3 rounded" style="background-color: rgba(125, 95, 255, 0.05); border: 1px dashed var(--border-color);">
    <p class="small text-white-50 mb-0">
        <i class="bi bi-info-circle"></i> Showing active products from <strong>Orbit 2005</strong> database. Use 'Details' to view descriptions, prices, and origin planets.
    </p>
</div>