@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model Planet
@section Styles {
    <link href="~/css/admin-products.css" rel="stylesheet" />
}
@section Breadcrumb {
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0 border-bottom border-secondary pb-2">
            <li class="breadcrumb-item">
                <a asp-controller="Admin" asp-action="Index" class="text-decoration-none" style="color: var(--cosmic-accent);">Orbit 2005</a>
            </li>
            <li class="breadcrumb-item active text-light" aria-current="page">Current Page Name</li>
        </ol>
    </nav>
}

<div class="card cosmic-card mx-auto" style="max-width: 800px;">
    <div class="card-body p-4">
        @if(TempData["successMsg"] != null)
        {
            <div class="alert alert alert-success">
                @TempData["successMsg"]
            </div>
        }
        <form action="#" method="post">

            <div class="mb-3">
                <label asp-for="Name" class="form-label cosmic-label">Planet Name</label>
                <input asp-for="Name" class="form-control cosmic-input"placeholder="e.g., Earth">
                <span class="text-white-50" asp-validation-for="Name"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Galaxy" class="form-label cosmic-label">Galaxy</label>
                <input asp-for="Galaxy" class="form-control cosmic-input" placeholder="e.g., Milky Way">
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label cosmic-label">Description</label>
                <textarea asp-for="Description" class="form-control cosmic-input" rows="5" placeholder="if something is special about this planet, mention it"></textarea>
            </div>
            
            <div class="text-end">
                <button type="submit" class="btn btn-cosmic px-5 py-2 fw-bold text-white-50 btn-info">Add Planet To System</button>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}