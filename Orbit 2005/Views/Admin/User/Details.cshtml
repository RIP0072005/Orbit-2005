@model Orbit_2005.Models.User
@{
    // افترضت إنك بتستخدم نفس الـ Layout بتاع الموقع
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "User Details";
}

<div class="container mt-5 pt-4" style="max-width: 1000px;">

    <!-- رأس الصفحة -->
    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom border-secondary pb-3">
        <div>
            <h2 class="text-light text-uppercase fw-bold m-0" style="letter-spacing: 1px;">Commander Profile</h2>
            <p class="text-white-50 m-0">User identity and galactic assets overview.</p>
        </div>
        <div class="text-info" style="font-family: monospace;">[ ID: @Model.Id.ToString("0000") ]</div>
    </div>

    <div class="row g-4">
        <!-- ========================================== -->
        <!-- 1. الكارت الأساسي (معلومات المستخدم) -->
        <!-- ========================================== -->
        <div class="col-lg-4">
            <div class="card cosmic-card bg-transparent border-info h-100 p-4 text-center" style="border-radius: 10px; background-color: rgba(20,20,30,0.5) !important;">

                <div class="mb-4 mt-3">
                    <!-- أيقونة تعبر عن اليوزر أو الأدمن -->
                    <span style="font-size: 5rem;">@(Model.Role == Orbit_2005.Models.UserRole.Admin ? "👑" : "👨‍🚀")</span>
                </div>

                <h4 class="text-light fw-bold text-uppercase mb-1">@Model.Name</h4>
                <p class="text-white-50 mb-3" style="font-family: monospace;">@Model.Email</p>

                <div class="mb-4">
                    @if (Model.Role == Orbit_2005.Models.UserRole.Admin)
                    {
                        <span class="badge bg-danger text-light border border-danger px-3 py-2">System Admin</span>
                    }
                    else
                    {
                        <span class="badge bg-dark text-info border border-info px-3 py-2">Regular Explorer</span>
                    }
                </div>

                <div class="text-start mt-auto pt-3 border-top border-secondary">
                    <small class="text-white-50 d-block mb-1">Origin Planet:</small>
                    <strong class="text-info">
                        @(Model.Planet != null ? Model.Planet.Name : "Unknown Sector")
                    </strong>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 2. الأصول والإحصائيات (Assets & Stats) -->
        <!-- ========================================== -->
        <div class="col-lg-8">
            <div class="row g-3">

                <!-- المحفظة (الرصيد) -->
                <div class="col-12">
                    <div class="card cosmic-card bg-transparent border-success p-3 hover-glow" style="border-radius: 10px;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-success text-uppercase mb-1">Galactic Credits Balance</h6>
                                <h3 class="text-light m-0 fw-bold">@Model.GalacticCredits.ToString("N0") <span class="text-success fs-5">GC</span></h3>
                            </div>
                            <div class="fs-1">💳</div>
                        </div>
                    </div>
                </div>

                <!-- الموارد (Resources) -->
                <h5 class="text-light mt-4 mb-2 fw-bold border-bottom border-secondary pb-2">Inventory & Resources</h5>

                <div class="col-md-4">
                    <div class="card bg-transparent border-secondary p-3 text-center" style="border-radius: 10px; background-color: rgba(0,0,0,0.3) !important;">
                        <span class="fs-2 mb-2">⚙️</span>
                        <span class="text-white-50 small text-uppercase">Titanium</span>
                        <h4 class="text-light m-0">@Model.Titanium</h4>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card bg-transparent border-secondary p-3 text-center" style="border-radius: 10px; background-color: rgba(0,0,0,0.3) !important;">
                        <span class="fs-2 mb-2">🔋</span>
                        <span class="text-white-50 small text-uppercase">Plasma Cores</span>
                        <h4 class="text-info m-0">@Model.PlasmaCores</h4>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card bg-transparent border-secondary p-3 text-center" style="border-radius: 10px; background-color: rgba(0,0,0,0.3) !important;">
                        <span class="fs-2 mb-2">🌌</span>
                        <span class="text-white-50 small text-uppercase">Dark Matter</span>
                        <h4 class="text-danger m-0">@Model.DarkMatter</h4>
                    </div>
                </div>

                <!-- إحصائيات النشاط (Activity Stats) -->
                <h5 class="text-light mt-4 mb-2 fw-bold border-bottom border-secondary pb-2">Activity Overview</h5>

                <div class="col-md-4">
                    <div class="d-flex align-items-center p-3 border border-secondary rounded" style="background-color: rgba(255,255,255,0.02);">
                        <span class="fs-3 me-3">📦</span>
                        <div>
                            <span class="text-white-50 small d-block">Total Orders</span>
                            <strong class="text-light">@(Model.Orders?.Count ?? 0)</strong>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex align-items-center p-3 border border-secondary rounded" style="background-color: rgba(255,255,255,0.02);">
                        <span class="fs-3 me-3">🛒</span>
                        <div>
                            <span class="text-white-50 small d-block">Items in Cart</span>
                            <strong class="text-light">@(Model.CartItems?.Count ?? 0)</strong>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex align-items-center p-3 border border-secondary rounded" style="background-color: rgba(255,255,255,0.02);">
                        <span class="fs-3 me-3">⭐</span>
                        <div>
                            <span class="text-white-50 small d-block">Favourites</span>
                            <strong class="text-light">@(Model.Favourites?.Count ?? 0)</strong>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .hover-glow:hover {
        border-color: #198754 !important; /* أخضر يليق مع الفلوس */
        box-shadow: 0 0 15px rgba(25, 135, 84, 0.2);
        transform: translateY(-3px);
        transition: 0.3s ease;
    }
</style>