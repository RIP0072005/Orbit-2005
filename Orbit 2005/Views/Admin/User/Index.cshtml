
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model List<User>

@section Styles {
    <link href="~/css/admin-products.css" rel="stylesheet" />
}
@section Breadcrumb {
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0 border-bottom border-secondary pb-2">
            <li class="breadcrumb-item">
                <a asp-controller="Admin" asp-action="Index" class="text-decoration-none" style="color: var(--cosmic-accent);">Orbit 2005</a>
            </li>
            <li class="breadcrumb-item active text-light" aria-current="page">Current Page Name</li>
        </ol>
    </nav>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="cosmic-page-title">Products Inventory</h2>
    <a asp-controller="User" asp-action="Create" class="btn btn-cosmic">+ Add New Admin</a>
</div>

@if (TempData["updateSuccessMsg"] != null)
{
    <div class="alert alert-success">
        @TempData["updateSuccessMsg"]
    </div>
}

<div class="table-responsive">
    <table class="table cosmic-table align-middle text-center">
        <thead>
            <tr>
                <th style="width: 10%;">Name</th>
                <th style="width: 25%;">Email</th>
                <th style="width: 25%;">Planet</th>
                <th style="width: 40%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-black-50 fw-bold">@item.Name</td>
                    <td class="text-black-50 fw-bold">@item.Email</td>
                    <td class="text-black-50 fw-bold">@item.Planet</td>
                    <td>
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-controller="User" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info px-3">More Info</a>
                            <a asp-controller="User" asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning px-3">Edit</a>
                            <!--Version 1 of deleting-->
                            @* <a asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to delete this product?');" class="btn btn-sm btn-outline-danger px-3">Delete</a> *@

                            <!--Version 2 of deleting-->
                            <form asp-controller="User" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are You Sure You Want To Remove this User from System?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger px-3">Delete</button>
                            </form>

                            @* <a asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-3">Delete</a> *@
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-4 p-3 rounded" style="background-color: rgba(125, 95, 255, 0.05); border: 1px dashed var(--border-color);">
    <p class="small text-white-50 mb-0">
        <i class="bi bi-info-circle"></i> Showing active products from <strong>Orbit 2005</strong> database. Use 'Details' to view descriptions, prices, and origin planets.
    </p>
</div>