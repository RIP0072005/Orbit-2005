@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Styles {
    <link href="~/css/admin-products.css" rel="stylesheet" />
}

@model User

@section Breadcrumb {
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0 border-bottom border-secondary pb-2">
            <li class="breadcrumb-item">
                <a asp-controller="Admin" asp-action="Index" class="text-decoration-none" style="color: var(--cosmic-accent);">Orbit 2005</a>
            </li>
            <li class="breadcrumb-item active text-light" aria-current="page">Current Page Name</li>
        </ol>
    </nav>
}

@if (TempData["successMsg"] != null)
{
    <div class="alert alert-success">
        @TempData["successMsg"]
    </div>
}

<div class="card cosmic-card mx-auto" style="max-width: 800px;">
    <div class="card-body p-4">
        @* <div class="text-danger" asp-validation-summary="All"></div> *@
        <form asp-controller="User" asp-action="Create" method="post">

            <div class="mb-3">
                <label asp-for="Name" class="form-label cosmic-label">User Name</label>
                <input asp-for="Name" class="form-control cosmic-input" placeholder="e.g., Lunar Dust">

                <span class="text-white-50" asp-validation-for="Name"></span>

            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label cosmic-label">Email</label>
                <input asp-for="Email" class="form-control cosmic-input" placeholder="example@gmail.com">
                <span class="text-white-50" asp-validation-for="Email"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label cosmic-label">Password</label>
                <input asp-for="Password" class="form-control cosmic-input">
                <span class="text-white-50" asp-validation-for="Password"></span>
            </div>

            <div class="mb-3">
                <label asp-for="planetId" class="form-label cosmic-label">Origin Planet</label>
                <select asp-for="planetId" class="form-select cosmic-input" asp-items="ViewBag.planets">
                    <option value="" disabled selected>Select a planet</option>
                </select>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-cosmic px-5 py-2 fw-bold">Add New Admin</button>
            </div>

        </form>
    </div>
</div>
@section Scripts
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}