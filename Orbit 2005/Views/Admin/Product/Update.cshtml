@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Styles{
    <link href="~/css/admin-products.css" rel="stylesheet" />
}
@model Product
@section Breadcrumb {
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0 border-bottom border-secondary pb-2">
            <li class="breadcrumb-item">
                <a asp-controller="Admin" asp-action="Index" class="text-decoration-none" style="color: var(--cosmic-accent);">Orbit 2005</a>
            </li>
            <li class="breadcrumb-item active text-light" aria-current="page">Current Page Name</li>
        </ol>
    </nav>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="cosmic-page-title">Update Product</h2>
    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">Back to Inventory</a>
</div>

<div class="card cosmic-card mx-auto" style="max-width: 800px;">
    <div class="card-header border-bottom border-secondary pb-3 pt-3 bg-transparent">
        <h5 class="mb-0 text-warning"><i class="bi bi-pencil-square"></i> Editing Product ID: #@Model.Id</h5>
    </div>

    <div class="card-body p-4">
        <form asp-controller="Product" asp-action="Update" method="post">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="mb-3">
                <label for="editProductName" class="form-label cosmic-label">Product Name</label>
                <input type="text" name="Name" class="form-control cosmic-input" id="editProductName" value="@Model.Name" required>
            </div>

            <div class="mb-3">
                <label for="editProductPrice" class="form-label cosmic-label">Price ($)</label>
                <input type="number" name="Price" step="0.01" class="form-control cosmic-input" id="editProductPrice" value="@Model.Price" required>
            </div>

            <div class="mb-3">
                <label for="editProductPrice" class="form-label cosmic-label">Available Amount</label>
                <input type="number" name="Amount" step="10" class="form-control cosmic-input" id="editProductPrice" value="@Model.Amount" required>
            </div>

            <div class="mb-4">
                <label for="editProductDescription" class="form-label cosmic-label">Description</label>
                <textarea class="form-control cosmic-input" id="editProductDescription" name="Description" rows="5">@Model.Description</textarea>
            </div>


            <div class="mb-3">
                <label for="productPlanet" class="form-label cosmic-label">Origin Planet (Category)</label>
                <select class="form-select cosmic-input" id="productPlanet" name="planetId">
                    @foreach (var planet in ViewBag.planets)
                    {
                        @if (@Model.planetId == @planet.Id)
                        {
                            <option value="@planet.Id" selected>@planet.Name</option>
                        }
                        else
                        {
                            <option value="@planet.Id">@planet.Name</option>
                        }
                    }
                </select>
            </div>
            
            <div class="text-end">
                <button type="submit" class="btn btn-warning px-5 py-2 fw-bold text-dark">Save Changes</button>
            </div>

        </form>
    </div>
</div>