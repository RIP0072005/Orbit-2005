@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Styles {
    <link href="~/css/admin-products.css" rel="stylesheet" />
}
@model Product

@section Breadcrumb {
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0 border-bottom border-secondary pb-2">
            <li class="breadcrumb-item">
                <a asp-controller="Admin" asp-action="Index" class="text-decoration-none" style="color: var(--cosmic-accent);">Orbit 2005</a>
            </li>
            <li class="breadcrumb-item active text-light" aria-current="page">Current Page Name</li>
        </ol>
    </nav>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="cosmic-page-title">Add New Space Product</h2>
    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">Back to Inventory</a>
</div>


@if(TempData["successMsg"] != null)
{
    <div class="alert alert-success">
        @TempData["successMsg"]
    </div>
}
<div class="card cosmic-card mx-auto" style="max-width: 800px;">
    <div class="card-body p-4">
        @* <div class="text-danger" asp-validation-summary="All"></div> *@
        <form asp-controller="Product" asp-action="Create" method="post">

            <div class="mb-3">
                <label asp-for="Name" class="form-label cosmic-label">Product Name</label>
                <input asp-for="Name" class="form-control cosmic-input" placeholder="e.g., Lunar Dust">
               
                <span class="text-white-50" asp-validation-for = "Name"></span>
                
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label cosmic-label">Price ($)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control cosmic-input" id="productPrice" placeholder="0.00">
                <span class="text-white-50" asp-validation-for="Price"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label cosmic-label">Description</label>
                <textarea asp-for="Description" class="form-control cosmic-input" id="productDescription" rows="5" placeholder="Describe the rare materials, origin, and uses..."></textarea>
                <span class="text-white-50" asp-validation-for="Description"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label cosmic-label">Available Amount</label>
                <input asp-for="Amount" type="number" step="1" class="form-control cosmic-input" id="productAmount" placeholder="" required>
                <span class="text-white-50" asp-validation-for="Amount"></span>
            </div>

            <div class="mb-3">
                <label asp-for="planetId" class="form-label cosmic-label">Origin Planet (Category)</label>
                <select asp-for="planetId" class="form-select cosmic-input" asp-items="ViewBag.planets">
                    <option value="" disabled selected>Select a planet</option>
                </select>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-cosmic px-5 py-2 fw-bold">Launch Product</button>
            </div>

        </form>
    </div>
</div>
@section Scripts
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}