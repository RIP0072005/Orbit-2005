@using Orbit_2005.Models.ViewModels
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    @model List<ProductPlanetViewModel> 
}

@if (TempData["successfulSign"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-success border-success bg-transparent text-success d-flex justify-content-between align-items-center shadow-sm" role="alert">
            <span>📈 @TempData["successfulSign"]</span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (TempData["error"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-danger border-danger bg-transparent text-danger d-flex justify-content-between align-items-center shadow-sm" role="alert">
            <span>⚠️ @TempData["error"]</span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<div class="container-fluid mt-5 pt-4" style="max-width: 1400px;">
    
    <!-- رأس الصفحة -->
    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom border-secondary pb-3">
        <div>
            <h2 class="text-light text-uppercase fw-bold m-0" style="letter-spacing: 1px;">Galactic Market</h2>
            <p class="text-white-50 m-0">Explore and trade materials from across the universe.</p>
        </div>
        <div class="text-info" style="font-family: monospace;">[ SYSTEM: ONLINE ]</div>
    </div>

    <div class="row">
        <!-- ========================================== -->
        <!-- 1. Sidebar (Filters & Search) -->
        <!-- ========================================== -->
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="card cosmic-card bg-transparent border-info p-4" style="border-radius: 10px; background-color: rgba(20,20,30,0.5) !important;">
                
                <!-- Search Bar -->
                <h5 class="text-info text-uppercase fw-bold mb-3">Search</h5>
                <div class="input-group mb-4">
                    <input type="text" class="form-control bg-transparent text-light border-secondary" placeholder="Search materials...">
                    <button class="btn btn-outline-info" type="button">🔍</button>
                </div>

                <!-- Filter by Planet -->
                <h5 class="text-info text-uppercase fw-bold mb-3">Origin Planet</h5>
                <div class="mb-4 text-light">
                    <!-- لما تقلبها ديناميك، هتعمل لوب هنا على الـ ViewBag.Planets -->
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" value="" id="planet1">
                        <label class="form-check-label text-white-50" for="planet1">Earth (45)</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" value="" id="planet2">
                        <label class="form-check-label text-white-50" for="planet2">Mars (12)</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" value="" id="planet3">
                        <label class="form-check-label text-white-50" for="planet3">Saturn (8)</label>
                    </div>
                </div>

                <button class="btn btn-info w-100 fw-bold text-dark text-uppercase">Apply Filters</button>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 2. Products Grid -->
        <!-- ========================================== -->
        <div class="col-lg-9 col-md-8">
            
            <!-- Sorting & Results count -->
            <div class="d-flex justify-content-between align-items-center mb-4 p-2 rounded" style="background-color: rgba(255,255,255,0.05);">
                <span class="text-white-50">Showing <span class="text-light fw-bold">6</span> items</span>
                <form asp-area="Customer" asp-controller="Product" asp-action="Index">
                    <select name="search" onchange="this.form.submit()" class="form-select w-auto bg-transparent text-light border-secondary small">
                        <option value="date" selected="@(ViewBag.sorted == "date")" style="color: black;">Sort by: Newest Arrivals</option>
                        <option value="low" selected="@(ViewBag.sorted == "low")" style="color: black;">Price: Low to High</option>
                        <option value="high" selected="@(ViewBag.sorted == "high")" style="color: black;">Price: High to Low</option>
                    </select>

                    @* <input type="submit" class="btn btn-info" /> *@
                </form>
            </div>

            <!-- Product Cards Row -->
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-sm-6 mb-4">
                        <div class="card cosmic-card h-100 bg-transparent border-secondary hover-glow" style="transition: 0.3s; border-radius: 10px;">
                            <div class="card-img-top bg-dark d-flex align-items-center justify-content-center" style="height: 200px; border-bottom: 1px solid #444; border-radius: 10px 10px 0 0;">
                                <span class="text-white-50 fs-1">☄️</span>
                            </div>
                            <div class="card-body">
                                <span class="badge bg-dark text-info mb-2 border border-info">@item.PlanetName</span> <!-- item.Planet.Name -->
                                <h5 class="card-title text-light">@item.ProductName</h5> <!-- item.Name -->
                                <p class="card-text text-white-50 small">High-energy crystal mined from the deep craters of Mars.</p> <!-- item.Description -->
                            </div>
                            <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center pb-3">
                                <span class="text-success fw-bold fs-5">$@item.Price</span> <!-- item.Price -->
                                <a asp-area="Customer" asp-controller="Product" asp-action="details" asp-route-id = "@item.ProductId" class="btn btn-sm btn-warning text-dark fw-bold">More Details</a>
                            </div>
                        </div>
                    </div>
                }
                
            </div>
            <!-- Pagination (ترقيم الصفحات لو المنتجات كتير) -->
            <nav class="mt-4">
                <ul class="pagination justify-content-center custom-pagination">
                    <li class="page-item disabled"><a class="page-link bg-transparent text-secondary border-secondary" href="#">Previous</a></li>
                    <li class="page-item active"><a class="page-link bg-info text-dark border-info" href="#">1</a></li>
                    <li class="page-item"><a class="page-link bg-transparent text-info border-secondary" href="#">2</a></li>
                    <li class="page-item"><a class="page-link bg-transparent text-info border-secondary" href="#">Next</a></li>
                </ul>
            </nav>

        </div>
    </div>
</div>

<style>
    .hover-glow:hover {
        border-color: var(--cosmic-accent, #0dcaf0) !important;
        box-shadow: 0 0 15px rgba(13, 202, 240, 0.2);
        transform: translateY(-5px);
    }
    
    /* ستايل صغير عشان ترقيم الصفحات يبقى ماشي مع الدارك ثيم */
    .custom-pagination .page-link:hover {
        background-color: #0dcaf0 !important;
        color: #000 !important;
    }
</style>