@using Orbit_2005.Models
@model IEnumerable<Planet>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Galactic Markets";
}

<div class="container mt-5 pt-4">
    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="text-light text-uppercase fw-bold" style="letter-spacing: 2px;">
            <span class="text-info">Planetary</span> Markets
        </h1>
        <p class="text-white-50">Explore rare materials and artifacts from across the galaxy</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning bg-transparent border-warning text-warning text-center p-5 rounded-3">
            <h4>No planets detected in this sector!</h4>
            <p class="mb-0">Please check your radar or contact the admin to add categories.</p>
        </div>
    }
    else
    {
        @foreach (var planet in Model)
        {
            <!-- قسم الكوكب -->
            <div class="mb-5 pb-4 border-bottom border-secondary" style="border-bottom-color: rgba(255,255,255,0.05) !important;">

                <!-- هيدر الكوكب -->
                <div class="d-flex align-items-center mb-4">
                    <div class="display-5 me-3" style="filter: drop-shadow(0 0 15px rgba(13, 202, 240, 0.4));">🪐</div>
                    <div>
                        <h2 class="text-light fw-bold text-uppercase m-0">@planet.Name</h2>
                        <span class="text-info small" style="letter-spacing: 1px;">ORBITAL MARKET</span>
                    </div>
                </div>

                <!-- منتجات الكوكب -->
                @if (planet.Products != null && planet.Products.Any())
                {
                    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
                        @foreach (var product in planet.Products)
                        {
                            <div class="col">
                                <div class="card cosmic-card bg-transparent border-secondary h-100 hover-glow" style="border-radius: 12px; background-color: rgba(20, 20, 30, 0.6) !important;">

                                    <!-- صورة المنتج (لو عندك مسار صورة في الموديل، غير src) -->
                                    <div class="card-img-top-container p-3 text-center">
                                        <i class="bi bi-box-seam text-secondary" style="font-size: 4rem;"></i>
                                    </div>

                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title text-light fw-bold">@product.Name</h5>

                                        <!-- السعر والكمية -->
                                        <div class="mt-auto pt-3 border-top border-secondary d-flex justify-content-between align-items-center">
                                            <span class="text-success fw-bold fs-5">$@product.Price</span>

                                            @if (product.Amount > 0)
                                            {
                                                <span class="badge bg-outline-info text-info border border-info rounded-pill">
                                                    In Stock: @product.Amount
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger rounded-pill">Out of Stock</span>
                                            }
                                        </div>
                                    </div>

                                    <!-- أزرار الأكشن -->
                                    <div class="card-footer bg-transparent border-0 p-3 pt-0 d-grid gap-2">
                                        <a asp-area="Customer" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-info btn-sm text-uppercase" style="letter-spacing: 1px;">
                                            View Details
                                        </a>

                                        @if (product.Amount > 0)
                                        {
                                            <!-- زرار الإضافة للسلة -->
                                            <form asp-area="Customer" asp-controller="Cart" asp-action="AddToCart" method="post" class="d-grid">
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <button type="submit" class="btn btn-info btn-sm fw-bold text-dark text-uppercase">
                                                    Add to Cargo
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- لو الكوكب مفيهوش منتجات -->
                    <div class="text-center py-4 bg-dark rounded border border-secondary" style="background-color: rgba(0,0,0,0.2) !important;">
                        <p class="text-white-50 m-0">No resources available from @planet.Name at the moment.</p>
                    </div>
                }
            </div>
        }
    }
</div>

@if (ViewBag.HasLoot != null && (bool)ViewBag.HasLoot == true)
{
    <!-- صندوق الموارد العائم -->
    <div id="lootBox" class="position-fixed bottom-0 end-0 m-4 p-4 bg-dark border border-info shadow-lg text-center" style="z-index: 1000; border-radius: 15px; box-shadow: 0 0 20px rgba(13, 202, 240, 0.3) !important;">
        <div class="display-6 mb-2">📦</div>
        <h5 class="text-info fw-bold text-uppercase">Hidden Stash!</h5>
        <p class="text-light small mb-3">Scan complete. Resources found.</p>

        <form asp-area="Customer" asp-controller="Economy" asp-action="ClaimLoot" method="post">
            <button type="submit" class="btn btn-info btn-sm fw-bold w-100 text-dark">CLAIM LOOT</button>
        </form>
    </div>
}
<style>
    .hover-glow {
        transition: all 0.3s ease;
    }

        .hover-glow:hover {
            border-color: var(--cosmic-accent, #0dcaf0) !important;
            box-shadow: 0 0 15px rgba(13, 202, 240, 0.2);
            transform: translateY(-5px);
        }
</style>