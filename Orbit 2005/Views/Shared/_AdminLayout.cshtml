<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_AdminHead"/>
    @RenderSection("Styles", required: false)
</head>
<body>
    <aside class="aside-sidebar">
        <partial name="_AdminAside"/>
    </aside>

    <div class="main-wrapper">
        <header>
            <nav class="navbar navbar-expand-lg cosmic-nav">
                <div class="container-fluid">
                    <span class="navbar-brand">Admin Dashboard</span>
                    <div class="ms-auto">
                        <span class="badge bg-primary">Captain: Ahmed Hegazy | RIP 2005</span>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main" class="container-fluid mt-4 px-4">

            @RenderSection("breadCrumb", required: false)

            @RenderBody() 
        </main>

        <footer>
            <partial name="_AdminFooter" />
        </footer>
    </div>

    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-layout.js"></script>
</body>
</html>