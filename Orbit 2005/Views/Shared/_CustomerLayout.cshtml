@using Orbit_2005.Repositories.Interfaces
@inject IUserRepository UserRepository
@inject ICartItemRepository CartItemRepository

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Orbit 2005 - The Cosmic Store</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/customer-layout.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg cosmic-navbar fixed-top">
            <div class="container">
                <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="navbar-brand orbit-brand">
                    <span class="brand-icon">🪐</span> Orbit 2005
                </a>
                <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="nav-link">Home Station</a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Customer" asp-controller="Product" asp-action="Category" class="nav-link">Explore Planets</a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Customer" asp-controller="Product" asp-action="Index" class="nav-link">Galactic Shop</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center">

                        @if (Context.Request.Cookies["UserId"] != null)
                        {
                            // 1. جلب بيانات المستخدم الحالي باستخدام الـ Repository
                            int.TryParse(Context.Request.Cookies["UserId"], out int userId);
                            var currentUser = UserRepository.GetById(userId);
                            <li class="nav-item">
                                <a asp-controller="Cart" asp-action="Index" class="nav-link cart-link">
                                    Cart <span class="badge rounded-pill bg-cosmic-accent">@(CartItemRepository.GetCartItemsByUserId(currentUser.Id).Count)</span>
                                </a>
                            </li>

                            // 2. عرض الرصيد (Galactic Credits)
                            <li class="nav-item ms-3 me-2">
                                <a asp-area="Customer" asp-controller="Economy" asp-action="BlackMarket" class="btn btn-outline-warning text-warning fw-bold d-flex align-items-center" style="border-radius: 20px; text-shadow: 0 0 5px rgba(255, 193, 7, 0.5);">
                                    <span class="me-1">💎</span> $@(currentUser?.GalacticCredits ?? 0)
                                </a>
                            </li>

                            // 3. زرار الحساب الشخصي
                            <li class="nav-item dropdown">
                                <a class="btn btn-outline-cosmic dropdown-toggle" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    My Account
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end cosmic-dropdown border-info bg-dark" aria-labelledby="accountDropdown">
                                    <li>
                                        <a class="dropdown-item text-light" asp-area="Customer" asp-controller="Account" asp-action="Details" asp-route-id="@userId">Account Details</a>
                                    </li>
                                    <li><hr class="dropdown-divider bg-secondary"></li>
                                    <li>
                                        <form asp-area="Customer" asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                            <button type="submit" class="dropdown-item text-danger fw-bold">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <a asp-controller="Cart" asp-action="Index" class="nav-link cart-link">
                                Cart <span class="badge rounded-pill bg-cosmic-accent">🔒</span>
                            </a>
                            <li class="nav-item ms-3">
                                <a asp-area="Customer" asp-controller="Account" asp-action="Login" class="btn btn-outline-cosmic">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-content">
        @RenderSection("breadCrumb", required: false)
        @RenderBody()
    </main>

    <footer class="cosmic-footer">
        <div class="container text-center">
            <p class="mb-1">&copy; 2026 - Orbit 2005 Store. Bridging galaxies together.</p>
            <p class="text-white-50 small">Powered by RIP 2005 Technologies</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/customer-layout.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>