<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Orbit 2005 - The Cosmic Store</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <link href="css/customer-layout.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg cosmic-navbar fixed-top">
            <div class="container">
                <a class="navbar-brand orbit-brand" href="index.html">
                    <span class="brand-icon">🪐</span> Orbit 2005
                </a>
                <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link active" href="index.html">Home Station</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="planets.html">Explore Planets</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="shop.html">Galactic Shop</a>
                        </li>
                    </ul>
                    
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a class="nav-link cart-link" href="cart.html">
                                Cart <span class="badge rounded-pill bg-cosmic-accent">0</span>
                            </a>
                        </li>
                        <li class="nav-item ms-3">
                            <a class="btn btn-outline-cosmic" href="login.html">Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-content">
        @RenderSection("breadCrumb", required: false)
        @RenderBody()
    </main>

    <footer class="cosmic-footer">
        <div class="container text-center">
            <p class="mb-1">&copy; 2026 - Orbit 2005 Store. Bridging galaxies together.</p>
            <p class="text-muted small">Powered by RIP 2005 Technologies</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/customer-layout.js"></script>
</body>
</html>